root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.py]
indent_size = 4

# Fixtures and test inputs are compared byte for byte; upstream cases are verbatim copies.
[{svgo/plugins/fixtures/**,svgo/testdata/**,app/website/samples/**,packages/compare/corpus/**}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
