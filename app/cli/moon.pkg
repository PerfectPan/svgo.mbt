import {
  "PerfectPan/svgo",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/string",
  "moonbitlang/core/json",
}

pkgtype(kind: "executable")

options(
  supported_targets: "native+js",
  "native-stub": [ "io.c" ],
  targets: {
    "io_native.mbt": [ "native" ],
    "io_js.mbt": [ "js" ],
    "io_stub.mbt": [ "wasm", "wasm-gc" ],
  },
)
