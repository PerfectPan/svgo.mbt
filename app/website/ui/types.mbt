///|
/// A row of the benchmark table (see data.mbt, generated).
pub(all) struct BenchRow {
  file : String
  original : Int
  mbt : Int
  js : Int
  js_default : Int
  mbt_ms : Double
  js_ms : Double
} derive(Eq)

///|
pub extend BenchRow with Eq::{not_equal, equal}

///|
/// An editor export bundled with the site (see samples.mbt, generated).
pub(all) struct Sample {
  name : String
  file : String
  svg : String
} derive(Eq)

///|
pub extend Sample with Eq::{not_equal, equal}

///|
pub(all) struct ApiMethod {
  name : String
  signature : String
  doc : String
} derive(Eq)

///|
pub extend ApiMethod with Eq::{not_equal, equal}

///|
pub(all) struct ApiItem {
  kind : String
  name : String
  signature : String
  doc : String
  file : String
  methods : Array[ApiMethod]
  impls : Array[String]
} derive(Eq)

///|
pub extend ApiItem with Eq::{not_equal, equal}

///|
pub(all) struct ApiPackage {
  path : String
  short : String
  items : Array[ApiItem]
} derive(Eq)

///|
pub extend ApiPackage with Eq::{not_equal, equal}

///|
/// One command-line flag, parsed from the CLI's usage text at build time
/// (see cli_data.mbt, generated by app/website/gen.mjs).
pub(all) struct CliFlag {
  flag : String
  description : String
} derive(Eq)

///|
pub extend CliFlag with Eq::{not_equal, equal}

///|
/// What one optimize() call produced, in a form the views can compare.
pub(all) struct Outcome {
  data : String
  original_size : Int
  size : Int
  passes : Int
  applied : Array[String]
  ms : Double
  error : String
} derive(Eq)

///|
pub extend Outcome with Eq::{not_equal, equal}

///|
pub fn Outcome::empty() -> Outcome {
  {
    data: "",
    original_size: 0,
    size: 0,
    passes: 0,
    applied: [],
    ms: 0.0,
    error: "",
  }
}

///|
pub fn Outcome::saved_percent(self : Outcome) -> Double {
  if self.original_size == 0 {
    0.0
  } else {
    (self.original_size - self.size).to_double() *
    100.0 /
    self.original_size.to_double()
  }
}

///|
/// Run the optimizer in the browser and time it.
pub fn run_optimize(
  svg : String,
  plugins? : Array[String],
  precision? : Int = 3,
  multipass? : Bool = true,
  pretty? : Bool = false,
) -> Outcome {
  let base = @svgo.Config::default()
  let config : @svgo.Config = {
    ..base,
    plugins: plugins.unwrap_or(base.plugins),
    precision,
    multipass,
    pretty,
  }
  let t0 = perf_now()
  let r = @svgo.optimize(svg, config~) catch {
    e => return { ..Outcome::empty(), error: e.to_string(), }
  }
  let ms = perf_now() - t0
  {
    data: r.data,
    original_size: r.original_size,
    size: r.size,
    passes: r.passes,
    applied: r.applied,
    ms,
    error: "",
  }
}

///|
/// svgo.mbt's plugins as (name, description, on by default).
let all_plugins : Array[(String, String, Bool)] = @svgo.list_plugins()

///|
/// The default plugins, in svgo's preset-default order.
let default_plugins : Array[(String, String, Bool)] = all_plugins.filter(it => {
  it.2
})

///|
/// The one opt-in plugin svgo itself runs by default; the site lists it
/// first and says so.
let svgo_default_opt_in : String = "moveGroupAttrsToElems"

///|
/// The opt-in plugins as the site lists them (the playground's plugin
/// column and the landing page's pipeline sheet): `svgo_default_opt_in`
/// first, then the rest in the library's order.
let opt_in_plugins : Array[(String, String, Bool)] = {
  let optional = all_plugins.filter(it => !it.2)
  [
    ..optional.filter(it => it.0 == svgo_default_opt_in),
    ..optional.filter(it => it.0 != svgo_default_opt_in),
  ]
}

///|
/// A plugin's zero-padded position in the default pipeline.
fn pipeline_number(idx : Int) -> String {
  if idx < 9 {
    "0\{idx + 1}"
  } else {
    "\{idx + 1}"
  }
}
