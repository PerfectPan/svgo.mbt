///|
/// `using` is package wide in MoonBit, so every HTML helper the views need
/// is imported once here.
using @html {
  a,
  aside,
  button,
  code,
  div,
  footer,
  h1,
  h2,
  h3,
  h4,
  i,
  input,
  label,
  main_,
  nav,
  node,
  nothing,
  option,
  p,
  pre,
  section,
  select,
  small,
  span,
  table,
  tbody,
  td,
  text,
  textarea,
  th,
  thead,
  tr,
  type Html,
  type Attrs,
}

///|
using @rabbita {type Val, type Emit, none}
